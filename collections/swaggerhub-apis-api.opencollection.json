{
  "opencollection": "1.0.0",
  "info": {
    "name": "SwaggerHub Registry APIs API",
    "version": "1.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "APIs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Owner APIs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swaggerhub.com/apis/:owner",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path",
                "description": "Owner username or organization name"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of all API definitions owned by the specified user or organization."
        },
        {
          "info": {
            "name": "Get API Versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swaggerhub.com/apis/:owner/:api",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns all versions of the specified API."
        },
        {
          "info": {
            "name": "Create or Update API",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.swaggerhub.com/apis/:owner/:api",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Version string (defaults to 0.0.1)"
              },
              {
                "name": "isPrivate",
                "value": "",
                "type": "query"
              },
              {
                "name": "force",
                "value": "",
                "type": "query",
                "description": "Force update even if version is published"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new API or update an existing API definition in SwaggerHub. Pass the OpenAPI or AsyncAPI specification in the request body."
        },
        {
          "info": {
            "name": "Delete API",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.swaggerhub.com/apis/:owner/:api",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete all versions of the specified API."
        },
        {
          "info": {
            "name": "Rename API",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/rename",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "newName",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Rename an API definition within the same owner namespace."
        },
        {
          "info": {
            "name": "Get API Definition",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the OpenAPI or AsyncAPI definition for a specific API version."
        },
        {
          "info": {
            "name": "Delete API Version",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a specific version of an API."
        },
        {
          "info": {
            "name": "Get API Definition JSON",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/swagger.json",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the API definition in JSON format for a specific version."
        },
        {
          "info": {
            "name": "Get API Definition YAML",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/swagger.yaml",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the API definition in YAML format for a specific version."
        },
        {
          "info": {
            "name": "Fork API Version",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/fork",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              },
              {
                "name": "newOwner",
                "value": "",
                "type": "query"
              },
              {
                "name": "newApi",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Create a fork of a specific API version in a new owner namespace."
        },
        {
          "info": {
            "name": "Clone API Version",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/clone",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              },
              {
                "name": "newVersion",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Create a new version by cloning an existing version."
        },
        {
          "info": {
            "name": "Get API Comments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/comments",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve all comments on a specific API version."
        },
        {
          "info": {
            "name": "Add API Comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/comments",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new review comment to a specific API version."
        }
      ]
    }
  ],
  "bundled": true
}