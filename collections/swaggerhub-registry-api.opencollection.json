        {
          "info": {
            "name": "Create or Update API",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.swaggerhub.com/apis/:owner/:api",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Version string (defaults to 0.0.1)"
              },
              {
                "name": "isPrivate",
                "value": "",
                "type": "query"
              },
              {
                "name": "force",
                "value": "",
                "type": "query",
                "description": "Force update even if version is published"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
