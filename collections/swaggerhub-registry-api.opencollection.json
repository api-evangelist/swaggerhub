{
  "opencollection": "1.0.0",
  "info": {
    "name": "SwaggerHub Registry API",
    "version": "1.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search APIs Domains and Templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swaggerhub.com/specs",
            "params": [
              {
                "name": "specType",
                "value": "",
                "type": "query",
                "description": "Filter by specification type"
              },
              {
                "name": "owner",
                "value": "",
                "type": "query",
                "description": "Filter by owner username or organization"
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Free-text search query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a paginated list of APIs, domains, and/or templates based on search criteria. Filter by type, owner, visibility, tags, and more."
        }
      ]
    },
    {
      "info": {
        "name": "APIs",
        "type": "folder"
