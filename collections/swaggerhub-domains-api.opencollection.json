{
  "opencollection": "1.0.0",
  "info": {
    "name": "SwaggerHub Registry APIs Domains API",
    "version": "1.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Domains",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Domain Versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swaggerhub.com/domains/:owner/:domain",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns all versions of the specified domain."
        },
        {
          "info": {
            "name": "Create or Update Domain",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.swaggerhub.com/domains/:owner/:domain",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update a shared component domain in SwaggerHub."
        },
        {
          "info": {
            "name": "Delete Domain",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.swaggerhub.com/domains/:owner/:domain",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete all versions of the specified domain."
        }
      ]
    }
  ],
  "bundled": true
}