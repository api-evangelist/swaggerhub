{
  "opencollection": "1.0.0",
  "info": {
    "name": "SwaggerHub Registry APIs Settings API",
    "version": "1.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Lifecycle Settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/settings/lifecycle",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the publish/unpublish status of an API version."
        },
        {
          "info": {
            "name": "Update Lifecycle Settings",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/settings/lifecycle",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Publish or unpublish an API version."
        }
      ]
    }
  ],
  "bundled": true
}