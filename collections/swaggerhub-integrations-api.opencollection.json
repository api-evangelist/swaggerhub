{
  "opencollection": "1.0.0",
  "info": {
    "name": "SwaggerHub Registry APIs Integrations API",
    "version": "1.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Integrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/integrations",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List all integrations configured for a specific API version."
        },
        {
          "info": {
            "name": "Create Integration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/integrations",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Configure a new integration (CI/CD, GitHub sync, etc.) for an API version."
        },
        {
          "info": {
            "name": "Delete Integration",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/integrations/:integrationId",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              },
              {
                "name": "integrationId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove an integration from an API version."
        },
        {
          "info": {
            "name": "Execute Integration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.swaggerhub.com/apis/:owner/:api/:version/integrations/:integrationId/execute",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "api",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              },
              {
                "name": "integrationId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Manually trigger an integration to run against the current API version."
        }
      ]
    }
  ],
  "bundled": true
}